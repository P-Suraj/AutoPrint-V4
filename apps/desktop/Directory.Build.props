<Project>
  <!-- Shown in Windows file properties and the installer. Windows shows a PUBLISHER name in the SmartScreen
       prompt only for a code-signed program; these fields do not replace signing (see docs/DESKTOP_DISTRIBUTION.md). -->
  <PropertyGroup>
    <Authors>Suraj Pandavula</Authors>
    <Company>Suraj Pandavula</Company>
    <Product>AutoPrint</Product>
    <Copyright>Copyright © 2026 Suraj Pandavula</Copyright>
    <Description>AutoPrint print-shop agent: receives approved print jobs and sends them to the shop's printer.</Description>
    <Version>4.0.4</Version>
    <AssemblyVersion>4.0.4.0</AssemblyVersion>
    <FileVersion>4.0.4.0</FileVersion>
    <NeutralLanguage>en</NeutralLanguage>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RepositoryUrl>https://github.com/P-Suraj/AutoPrint-V4</RepositoryUrl>
  </PropertyGroup>
</Project>
