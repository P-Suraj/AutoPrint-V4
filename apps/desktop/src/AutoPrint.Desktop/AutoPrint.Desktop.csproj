<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 (1903) or newer: needed for Windows.Data.Pdf, the built-in PDF renderer used for previews. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AutoPrint.Desktop</RootNamespace>
    <AssemblyName>AutoPrint</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- No packer, no obfuscation, no single-file self-extractor: those are what antivirus products distrust most. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <!-- File properties Windows shows under Details, and what SmartScreen and antivirus read as the publisher text. -->
    <Version>4.0.1</Version>
    <AssemblyVersion>4.0.1.0</AssemblyVersion>
    <FileVersion>4.0.1.0</FileVersion>
    <Product>AutoPrint</Product>
    <Company>Suraj Pandavula</Company>
    <Authors>Suraj Pandavula</Authors>
    <Copyright>Copyright (c) 2026 Suraj Pandavula</Copyright>
    <Description>AutoPrint shop app: receives customer print requests and prints them on this computer.</Description>
    <InformationalVersion>4.0.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <None Include="tools\SumatraPDF.exe" Condition="Exists('tools\SumatraPDF.exe')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoPrint.Core\AutoPrint.Core.csproj" />
  </ItemGroup>

</Project>
