<Window x:Class="AutoPrint.Desktop.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview" Width="760" Height="760" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="Title1" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="Detail" Foreground="DimGray" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#D9DEE8" CornerRadius="8">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Image x:Name="PageImage" Margin="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                </ScrollViewer>
                <TextBlock x:Name="Message" Text="Loading the file…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#444" TextWrapping="Wrap" TextAlignment="Center" Margin="24"/>
            </Grid>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="Prev" Content="‹ Previous" Click="OnPrev" IsEnabled="False"/>
                <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="Next" Content="Next ›" Click="OnNext" IsEnabled="False"/>
            </StackPanel>
            <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ApproveBtn" Content="Approve and print" Click="OnApprove" Background="#1D4ED8" Foreground="White" Margin="0,0,8,0"/>
                <Button x:Name="RejectBtn" Content="Reject" Click="OnReject" Margin="0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
