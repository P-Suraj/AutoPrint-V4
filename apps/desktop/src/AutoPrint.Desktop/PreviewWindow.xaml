<Window x:Class="AutoPrint.Desktop.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview" Width="820" Height="780" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Style="{StaticResource Eyebrow}" Text="ORDER CODE"/>
                    <TextBlock x:Name="Code" Style="{StaticResource OrderCode}" FontSize="26"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="Title1" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="Detail" Style="{StaticResource Soft}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="20,0,0,0">
                    <TextBlock Style="{StaticResource Eyebrow}" Text="TO COLLECT" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="AmountText" Style="{StaticResource Amount}" FontSize="22"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#E2E8F0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="False">
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Margin="18" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Image x:Name="PageImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </ScrollViewer>
            <Border x:Name="MessageBox1" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="20,14"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24">
                <TextBlock x:Name="Message" Style="{StaticResource Body}" Text="Getting the file…" TextAlignment="Center"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="Prev" Content="‹  Previous" Click="OnPrev" IsEnabled="False" Padding="12,0"/>
                    <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource Muted}" MinWidth="84" TextAlignment="Center"/>
                    <Button x:Name="Next" Content="Next  ›" Click="OnNext" IsEnabled="False" Padding="12,0"/>
                </StackPanel>
                <StackPanel x:Name="Actions" DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RejectBtn" Content="Reject" Click="OnReject" Style="{StaticResource Danger}" Margin="0,0,8,0"/>
                    <Button x:Name="ApproveBtn" Content="Approve and print" Click="OnApprove" Style="{StaticResource Primary}"/>
                </StackPanel>
                <TextBlock x:Name="Why" Style="{StaticResource Soft}" VerticalAlignment="Center" Margin="16,0" TextAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
