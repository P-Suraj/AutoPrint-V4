<Window x:Class="AutoPrint.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoPrint" Width="920" Height="700" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- ============================================================ header: who, and is it connected -->
        <Border Grid.Row="0" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,14">
            <DockPanel>
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="Settings" Click="OnSettings" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Margin="0,1,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" VerticalAlignment="Center" Text="Starting…"/>
                </StackPanel>
                <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="9" Background="{StaticResource Ink}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE749;" Style="{StaticResource Icon}" Foreground="White" FontSize="18" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="ShopTitle" FontSize="19" FontWeight="SemiBold" Text="AutoPrint" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ShopSub" Style="{StaticResource Soft}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Print requests from your customers"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================ what needs saying right now -->
        <StackPanel x:Name="Banners" Grid.Row="1" Margin="24,14,24,0"/>

        <!-- ============================================================ starting, or something is wrong before the queue can show -->
        <StackPanel x:Name="StartView" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Margin="24" Visibility="Collapsed">
            <TextBlock x:Name="StartTitle" Style="{StaticResource H2}" HorizontalAlignment="Center" Text="Starting…"/>
            <TextBlock x:Name="StartNote" Style="{StaticResource Soft}" TextAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- ============================================================ connect this computer -->
        <ScrollViewer x:Name="PairView" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Focusable="False">
            <Border Style="{StaticResource CardBox}" MaxWidth="560" Margin="24,10,24,24" Padding="32,28" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Connect this computer to your shop"/>
                    <TextBlock x:Name="PairWhy" Style="{StaticResource Soft}" Margin="0,6,0,0" Text="You do this once. It takes about a minute."/>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="1" FontWeight="Bold" Foreground="{StaticResource Brand}" FontSize="16"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Body}" Margin="0,0,0,16"
                                   Text="Open your private AutoPrint shop link, on your phone or on this computer."/>
                        <TextBlock Grid.Row="1" Text="2" FontWeight="Bold" Foreground="{StaticResource Brand}" FontSize="16"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource Body}" Text="Under “Connect a computer”, type this code:"/>
                            <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,10,0,0" HorizontalAlignment="Left">
                                <TextBlock x:Name="PairCode" FontFamily="{StaticResource Mono}" FontSize="44" FontWeight="Bold" Text="····-····"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="3" FontWeight="Bold" Foreground="{StaticResource Brand}" FontSize="16"/>
                        <TextBlock x:Name="PairStep3" Grid.Row="2" Grid.Column="1" Style="{StaticResource Body}"
                                   Text="Check the computer name and press “Yes, connect it”."/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource Line}" Margin="0,22,0,14"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Get a new code" Click="OnNewCode" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PairNote" Style="{StaticResource Soft}" VerticalAlignment="Center" Text="Getting a code…"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ============================================================ the working screen -->
        <Grid x:Name="QueueView" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource Chip}" CornerRadius="12" Padding="4" HorizontalAlignment="Left" Margin="24,14,24,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabRequests" Style="{StaticResource Tab}" GroupName="tabs" IsChecked="True" Checked="OnTab" Content="Requests"/>
                    <RadioButton x:Name="TabFinished" Style="{StaticResource Tab}" GroupName="tabs" Checked="OnTab" Content="Finished"/>
                </StackPanel>
            </Border>

            <Grid x:Name="RequestsPane" Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="24,14,24,12">
                    <StackPanel x:Name="Cards"/>
                </ScrollViewer>
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="24" IsHitTestVisible="False">
                    <TextBlock Style="{StaticResource H2}" FontSize="18" HorizontalAlignment="Center" Text="No print requests right now"/>
                    <TextBlock x:Name="EmptyNote" Style="{StaticResource Soft}" FontSize="14" TextAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <DockPanel x:Name="FinishedPane" Grid.Row="1" Visibility="Collapsed" Margin="24,14,24,0">
                <Grid DockPanel.Dock="Top" MaxWidth="380" HorizontalAlignment="Left" Width="380">
                    <TextBox x:Name="SearchBox" Padding="36,0,36,0" TextChanged="OnSearch" MaxLength="40" CharacterCasing="Upper"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource Muted}" Margin="13,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchHint" Text="Find an order by its code, like K7QD" Foreground="{StaticResource Muted}" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <Button x:Name="SearchClear" Style="{StaticResource Quiet}" Click="OnSearchClear" HorizontalAlignment="Right" Margin="0,0,4,0" Padding="8,0" Visibility="Collapsed" ToolTip="Clear">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Muted}"/>
                    </Button>
                </Grid>
                <TextBlock x:Name="FinishedNote" DockPanel.Dock="Top" Style="{StaticResource Soft}" Margin="0,10,0,10"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <Border x:Name="FinishedBox" Style="{StaticResource CardBox}" Padding="18,4" VerticalAlignment="Top">
                        <StackPanel x:Name="FinishedRows"/>
                    </Border>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
